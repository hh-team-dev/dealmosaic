node_modules
dist
*.db
*.db-wal
*.db-shm
.env
.env.local
deploy/SECRETS.local.env

# Generated at build time by scripts/generate-seo.mjs — never hand-edited.
apps/web/public/sitemap.xml
apps/web/public/robots.txt
apps/web/public/llms.txt

# Backups and secrets — never committed, never shared via repository
backups/
secrets/*
!secrets/.gitignore
!secrets/README.md

# Live affiliate feed config — per-owner, points at local export paths.
# The EXAMPLES are committed; the real mapping and feed exports are not.
deploy/feeds/mapping.json
deploy/feeds/*.csv
!deploy/feeds/example-feed.csv

# Public database snapshots ARE committed (db-snapshots/). Private dumps never
# land here — scripts/db-backup.mjs writes them to ~/.config/dealmosaic/db/.
