# ---------------------------------------------------------------------------
# DEALMOSAIC — environment reference
#
# Copy to .env (never commit .env). Every variable below is grouped by whether
# the code ACTUALLY READS IT TODAY. Anything marked "reserved" is not wired yet —
# this file does not promise features that do not exist.
# ---------------------------------------------------------------------------

# ---------- Read by the code today ----------

# API
PORT=8787
NODE_ENV=development
DB_PATH=./apps/api/data/dealmosaic.db

# eBay Browse API connector — the only free, legal, self-serve live price source
# available today. Leave blank and the connector reports "disabled" with a reason.
# Get keys: developer.ebay.com → Application Keys → Production keyset (~15 min).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay has no India marketplace. Leave unset for EBAY_IN, or use a supported
# market (EBAY_GB, EBAY_US) to exercise live data end to end.
EBAY_MARKETPLACE_ID=

# SITE_URL is read by scripts/generate-seo.mjs to build sitemap.xml, robots.txt
# and canonical URLs at build time.
SITE_URL=https://dealmosaic.in

# ---------- Reserved: documented, NOT yet implemented ----------
# Listed so nobody assumes these work. See docs/15-project-handover.md §14.

# PostgreSQL / Supabase. The app currently uses SQLite only; no Postgres driver
# is installed. Required before any multi-instance deployment.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email delivery. Verification and reset links currently go to the dev outbox at
# GET /api/dev/outbox. EMAIL_PROVIDER is read only to log which provider would be
# used — NO mail is actually sent. A real integration is required before launch.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=

# Deployment credentials. Used by the host's CI, never by application code.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ---------- Not needed ----------
# There is no SESSION_SECRET. Sessions are opaque random tokens stored hashed in
# the database and revoked server-side, so no signing key exists to leak.
