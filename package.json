{
  "name": "dealmosaic",
  "private": true,
  "version": "2.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @dealmosaic/api",
    "dev:web": "npm run dev -w @dealmosaic/web",
    "build": "npm run seo && npm run build -w @dealmosaic/web && node scripts/build-pwa.mjs && npm run prerender && node scripts/verify-prerender.mjs",
    "preview": "npm run preview -w @dealmosaic/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:design": "node scripts/audit-design.mjs",
    "check": "npm run typecheck && npm run test && npm run audit:design && npm run secrets:scan",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p packages/core/tsconfig.json --noEmit",
    "seo": "tsx scripts/generate-seo.mjs",
    "backup": "node scripts/secrets-scan.mjs && node scripts/backup.mjs",
    "backup:list": "node scripts/backup.mjs --list",
    "backup:verify": "node scripts/backup.mjs --verify",
    "vault:init": "node scripts/vault.mjs init",
    "vault:edit": "node scripts/vault.mjs edit",
    "vault:show": "node scripts/vault.mjs show",
    "vault:set": "node scripts/vault.mjs set",
    "vault:get": "node scripts/vault.mjs get",
    "vault:rotate": "node scripts/vault.mjs rotate",
    "vault:status": "node scripts/vault.mjs status",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "db:snapshot": "node scripts/db-backup.mjs",
    "db:snapshot:private": "node scripts/db-backup.mjs --private",
    "db:verify": "node scripts/db-backup.mjs --verify",
    "prerender": "node scripts/prerender.mjs",
    "audit:browser": "node scripts/audit-browser.mjs",
    "audit:interactions": "playwright test",
    "build:classic": "VITE_PWA_MODE=classic npm run build",
    "test:pwa": "playwright test -c playwright.pwa.config.mjs",
    "package:pwa": "node scripts/package-pwa.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.3",
    "axe-core": "^4.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
